// Debate.kz database schema (PostgreSQL 16, Prisma 7)
// Connection URL lives in prisma.config.ts (Prisma 7 style), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

// Global roles only. Organizer / judge / speaker are rights inside a tournament.
enum Role {
  user
  admin
}

enum OrganizerRole {
  owner
  co_organizer
}

enum InviteKind {
  judge
  co_organizer
}

enum TokenPurpose {
  verify_email
  reset_password
  telegram_link // one-time deep link t.me/<bot>?start=<token>
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum TournamentLevel {
  school
  university
  mixed // school and university teams together
}

enum TournamentStatus {
  registration
  ongoing
  finished
}

// preliminary rounds make the standings; elimination rounds (the break: quarterfinal, semifinal, final) decide the champion
enum RoundKind {
  preliminary
  elimination
}

enum RoundStatus {
  draft
  released
  completed
}

// WSDC, APF, Karl Popper: proposition / opposition.
// British Parliamentary: proposition = Opening Government, opposition = Opening Opposition, plus the closing half.
enum Side {
  proposition
  opposition
  closingProposition @map("closing_proposition")
  closingOpposition  @map("closing_opposition")
}

enum BallotStatus {
  pending
  submitted
  confirmed
}

enum RegistrationStatus {
  pending
  confirmed
  rejected
  waitlisted // no place yet: moves up when a place frees
}

// how the places are filled: the organizer one by one, first come, or a public lottery
enum SelectionMode {
  manual
  first_come
  lottery
}

enum Plan {
  free
  pro
}

// Pro payment by Kaspi QR: the organizer pays by the platform's QR with the reference in the comment,
// presses "I have paid" (pending), an admin checks the Kaspi statement and confirms or rejects
enum PaymentStatus {
  awaiting // reference issued, not paid yet
  pending // the organizer says it is paid; waits for an admin
  confirmed
  rejected
}

// ---------- people ----------

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?   @map("password_hash") // null: the account signs in only with Google
  googleId            String?   @unique @map("google_id") // Google account "sub"
  googleEmail         String?   @map("google_email") // the linked Google address (may differ from email)
  name                String
  phone               String?
  role                Role      @default(user)
  institution         String?
  city                String?
  avatarUrl           String?   @map("avatar_url") // /uploads/avatars/<file>.webp
  blocked             Boolean   @default(false)
  emailVerifiedAt     DateTime? @map("email_verified_at")
  consentAt           DateTime? @map("consent_at") // consent to personal data processing
  profileHidden       Boolean   @default(false) @map("profile_hidden") // "hide my public profile": no career page, no links
  passwordChangedAt   DateTime? @map("password_changed_at") // sessions issued before this are rejected
  telegramChatId      String?   @unique @map("telegram_chat_id") // private chat with the bot (= Telegram user id)
  telegramUsername    String?   @map("telegram_username")
  telegramNotify      Boolean   @default(true) @map("telegram_notify")
  language            String    @default("ru") // ru | kz: the bot speaks it (set on the site or with /lang)
  verifiedPhone       String?   @unique @map("verified_phone") // shared via the bot's "share contact": one phone, one account
  phoneVerifiedAt     DateTime? @map("phone_verified_at")
  safeguardingOfficer Boolean   @default(false) @map("safeguarding_officer") // receives and handles behaviour reports (set by an admin)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organizedTournaments TournamentOrganizer[]
  judgeProfiles        Judge[]
  speakerProfiles      Speaker[]
  registrations        TeamRegistration[]
  emailTokens          EmailToken[]
  createdInvites       TournamentInvite[]    @relation("InviteCreatedBy")
  usedInvites          TournamentInvite[]    @relation("InviteUsedBy")
  adminActions         AdminAction[]
  payments             Payment[]             @relation("PaymentPayer")
  clubMembership       ClubMember?
  clubLogs             ClubLog[]
  news                 News[]
  clubRequests         ClubJoinRequest[]     @relation("ClubRequester")
  handledClubRequests  ClubJoinRequest[]     @relation("ClubRequestHandler")
  handledPayments      Payment[]             @relation("PaymentHandler")
  notifications        Notification[]
  teammatePosts        TeammatePost[]
  teammateReplies      TeammateReply[]
  safetyReports        SafetyReport[]        @relation("SafetyReporter")
  handledSafetyReports SafetyReport[]        @relation("SafetyHandler")
  judgeFeedback        JudgeFeedback[]

  clubReports       ClubReport[]
  tournamentReviews TournamentReview[]
  strikes OrganizerStrike[]

  @@map("users")
}

// one-time email links (verification, password reset); only the SHA-256 hash is stored
model EmailToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose @default(verify_email)
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model Institution {
  id    String          @id @default(cuid())
  name  String          @unique
  city  String?
  level TournamentLevel

  teams  Team[]
  judges Judge[]

  @@map("institutions")
}

// ---------- tournaments ----------

model Tournament {
  id                   String           @id @default(cuid())
  name                 String
  city                 String
  region               String? // region code (content/geo.ts): 17 regions and Astana, Almaty, Shymkent
  district             String? // optional: a district of a big city or an address
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime         @map("end_date") @db.Date
  format               String           @default("WSDC")
  level                TournamentLevel
  status               TournamentStatus @default(registration)
  maxTeams             Int              @map("max_teams")
  selectionMode        SelectionMode    @default(manual) @map("selection_mode")
  clubQuota            Int?             @map("club_quota") // at most this many teams from one club (null: no limit)
  lotteryAt            DateTime?        @map("lottery_at") // when the selection lottery was drawn
  abandonedAt       DateTime?     @map("abandoned_at") // archived: not finished 7 days after the end
  remindedMotionsAt DateTime?     @map("reminded_motions_at")
  finishReminders   Int           @default(0) @map("finish_reminders") // 1: "finish it", 2: "the archive in 2 days"
  drawOptions       Json?         @map("draw_options") // the organizer's last draw settings, kept for the next round
  coverUrl             String?          @map("cover_url")
  organizerName        String           @map("organizer_name")
  description          String           @default("")
  preliminaryRounds    Int              @map("preliminary_rounds")
  breakSize            Int              @map("break_size")
  breakCategories      Json             @default("[]") @map("break_categories") // [{ key, name, size }]: extra brackets (novices, juniors…)
  languages            String[]
  plan                 Plan             @default(free)
  paid                 Boolean          @default(true)
  visible              Boolean          @default(true)
  registrationOpen     Boolean          @default(true) @map("registration_open")
  requireApproval      Boolean          @default(true) @map("require_approval")
  registrationDeadline DateTime?        @map("registration_deadline") @db.Date
  moderation           ModerationStatus @default(pending) // public only after admin approval
  moderationNote       String?          @map("moderation_note")
  rooms                String[]         @default([]) // organizer's own room names for the draw; empty = default list
  roomLinks            Json             @default("{}") @map("room_links") // online tournaments: room name -> video call link (https)
  checkinCode          String?          @map("checkin_code") // shown as a QR at the venue; teams scan it to mark themselves present
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organizers    TournamentOrganizer[]
  scoringConfig ScoringConfig?
  teams         Team[]
  judges        Judge[]
  rounds        Round[]
  schedule      ScheduleItem[]
  registrations TeamRegistration[]
  invites       TournamentInvite[]
  certificates  Certificate[]
  payments      Payment[]
  reviews       TournamentReview[]
  awards        TournamentAward[]

  @@index([status, startDate])
  @@index([moderation])
  @@map("tournaments")
}

model TournamentOrganizer {
  tournamentId String        @map("tournament_id")
  userId       String        @map("user_id")
  role         OrganizerRole @default(owner)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@map("tournament_organizers")
}

// Invitation link to join a tournament as judge or co-organizer; only the token hash is stored
model TournamentInvite {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  kind         InviteKind
  tokenHash    String     @unique @map("token_hash")
  createdById  String     @map("created_by_id")
  usedById     String?    @map("used_by_id")
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  email        String? // invite by email: only the account with this address can accept it
  declinedAt   DateTime?  @map("declined_at")
  judgeId      String?    @map("judge_id") // a judge added earlier without an account: accepting links that judge to the account
  createdAt    DateTime   @default(now()) @map("created_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  judge        Judge?     @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  createdBy    User       @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy       User?      @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("tournament_invites")
}

// WSDC score ranges; kept per tournament so other formats can plug in later
model ScoringConfig {
  tournamentId String     @id @map("tournament_id")
  speakerMin   Decimal    @default(60) @map("speaker_min") @db.Decimal(4, 1)
  speakerMax   Decimal    @default(80) @map("speaker_max") @db.Decimal(4, 1)
  replyMin     Decimal    @default(30) @map("reply_min") @db.Decimal(4, 1)
  replyMax     Decimal    @default(40) @map("reply_max") @db.Decimal(4, 1)
  step         Decimal    @default(0.5) @db.Decimal(3, 1)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("scoring_configs")
}

model ScheduleItem {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  day          Int
  time         String
  title        String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("schedule_items")
}

model Team {
  id                   String          @id @default(cuid())
  tournamentId         String          @map("tournament_id")
  name                 String
  institutionId        String?         @map("institution_id")
  city                 String?
  checkedInAt          DateTime?       @map("checked_in_at") // present at the venue (QR check-in or marked by the organizer)
  swing                Boolean         @default(false) // stand-in team that evens out the draw; never ranked
  breakSeed            Int?            @map("break_seed") // 1..breakSize once the break is announced; null = did not break
  breakCategory        String?         @map("break_category") // the bracket the team broke into: null = the open break
  categories           String[]        @default([]) // break categories the team may break in (keys of tournaments.break_categories)
  clubId               String?         @map("club_id") // the club the team came from (ratings, same-club draw rule)
  clubTeamId           String?         @map("club_team_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  tournament           Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution          Institution?    @relation(fields: [institutionId], references: [id])
  club                 Club?           @relation(fields: [clubId], references: [id], onDelete: SetNull)
  clubTeam             ClubTeam?       @relation(fields: [clubTeamId], references: [id], onDelete: SetNull)
  speakers             Speaker[]
  propositionIn        Debate[]        @relation("PropositionTeam")
  oppositionIn         Debate[]        @relation("OppositionTeam")
  closingPropositionIn Debate[]        @relation("ClosingPropositionTeam")
  closingOppositionIn  Debate[]        @relation("ClosingOppositionTeam")
  judgeConflicts       JudgeConflict[]
  judgeFeedback        JudgeFeedback[]

  @@unique([tournamentId, name])
  @@map("teams")
}

model Speaker {
  id       String         @id @default(cuid())
  teamId   String         @map("team_id")
  name     String
  position Int // 1..3 inside the team
  userId   String?        @map("user_id")
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  scores   SpeakerScore[]

  @@index([teamId])
  @@map("speakers")
}

model Judge {
  id            String             @id @default(cuid())
  tournamentId  String             @map("tournament_id")
  name          String
  institutionId String?            @map("institution_id")
  rating        Int                @default(5) // 1..10
  userId        String?            @map("user_id")
  tournament    Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution   Institution?       @relation(fields: [institutionId], references: [id])
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  debates       DebateJudge[]
  ballots       Ballot[]
  invites       TournamentInvite[]
  conflicts     JudgeConflict[]
  feedback      JudgeFeedback[]

  @@index([tournamentId])
  @@index([userId])
  @@map("judges")
}

model Round {
  id           String      @id @default(cuid())
  tournamentId String      @map("tournament_id")
  number       Int
  name         String
  motion       String      @default("")
  infoSlide    String?     @map("info_slide")
  status       RoundStatus @default(draft)
  kind         RoundKind   @default(preliminary)
  silent       Boolean     @default(false) // a closed round: results hidden from the public until the break (or until opened)
  teamsInRound Int?        @map("teams_in_round") // elimination: how many teams are still in (final = 2, BP final = 4)
  category     String? // elimination: the break category of this bracket (null = open)
  date         DateTime    @db.Date
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  debates      Debate[]

  @@unique([tournamentId, number])
  @@map("rounds")
}

model Debate {
  id                       String          @id @default(cuid())
  roundId                  String          @map("round_id")
  room                     String
  propositionTeamId        String          @map("proposition_team_id")
  oppositionTeamId         String          @map("opposition_team_id")
  // British Parliamentary only: the closing half of the room
  closingPropositionTeamId String?         @map("closing_proposition_team_id")
  closingOppositionTeamId  String?         @map("closing_opposition_team_id")
  winner                   Side?
  ranking                  Side[] // BP: the sides from 1st to 4th place (3/2/1/0 team points); empty in two-team formats
  bracketSlot              Int?            @map("bracket_slot") // elimination: the debate's place in the bracket, 0 at the top
  onlineUrl                String?         @map("online_url") // the room\'s video call; shown only to its teams, judges and organizers
  ballotStatus             BallotStatus    @default(pending) @map("ballot_status")
  round                    Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  proposition              Team            @relation("PropositionTeam", fields: [propositionTeamId], references: [id], onDelete: Cascade)
  opposition               Team            @relation("OppositionTeam", fields: [oppositionTeamId], references: [id], onDelete: Cascade)
  closingProposition       Team?           @relation("ClosingPropositionTeam", fields: [closingPropositionTeamId], references: [id], onDelete: Cascade)
  closingOpposition        Team?           @relation("ClosingOppositionTeam", fields: [closingOppositionTeamId], references: [id], onDelete: Cascade)
  judges                   DebateJudge[]
  ballots                  Ballot[]
  feedback                 JudgeFeedback[]

  @@index([roundId])
  @@map("debates")
}

// a personal conflict set by the organizer: this judge does not judge this team (relative, former coach…)
model JudgeConflict {
  judgeId String @map("judge_id")
  teamId  String @map("team_id")
  judge   Judge  @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([judgeId, teamId])
  @@index([teamId])
  @@map("judge_conflicts")
}

// a speaker's rating of a judge of their debate (1..5 and an optional comment); only the organizers read it
// a participant's or judge's rating of a finished tournament (1..5, optional comment); public, shown without names
// "best speaker" / "best judge" the organizer chose (from the site's suggestions); a diploma after the finish
// a strike for an organizer: an abandoned tournament or a last-minute cancellation; 3 active ones block new tournaments
model OrganizerStrike {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  tournamentId   String?   @map("tournament_id")
  tournamentName String    @map("tournament_name")
  reason         String // abandoned | late_cancel
  createdAt      DateTime  @default(now()) @map("created_at")
  liftedAt       DateTime? @map("lifted_at")
  liftedNote     String?   @map("lifted_note")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("organizer_strikes")
}

model TournamentAward {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  kind         String // best_speaker | best_judge
  speakerId    String?    @map("speaker_id")
  judgeId      String?    @map("judge_id")
  name         String // as printed (a snapshot)
  createdAt    DateTime   @default(now()) @map("created_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, kind])
  @@map("tournament_awards")
}

model TournamentReview {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  userId       String     @map("user_id")
  role         String // speaker | judge: shown next to the review instead of the name
  score        Int
  comment      String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@map("tournament_reviews")
}

model JudgeFeedback {
  id        String   @id @default(cuid())
  debateId  String   @map("debate_id")
  judgeId   String   @map("judge_id")
  userId    String   @map("user_id")
  teamId    String   @map("team_id")
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  debate    Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge     Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([debateId, judgeId, userId])
  @@index([judgeId])
  @@map("judge_feedback")
}

model DebateJudge {
  debateId String  @map("debate_id")
  judgeId  String  @map("judge_id")
  isChair  Boolean @default(false) @map("is_chair")
  debate   Debate  @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge    Judge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@id([debateId, judgeId])
  @@index([judgeId])
  @@map("debate_judges")
}

// one ballot per judge per debate
model Ballot {
  id          String         @id @default(cuid())
  debateId    String         @map("debate_id")
  judgeId     String         @map("judge_id")
  winner      Side
  ranking     Side[] // BP: the panel's ranking of the four teams, 1st to 4th
  submittedAt DateTime       @default(now()) @map("submitted_at")
  debate      Debate         @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge       Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  scores      SpeakerScore[]

  @@unique([debateId, judgeId])
  @@map("ballots")
}

model SpeakerScore {
  id        String  @id @default(cuid())
  ballotId  String  @map("ballot_id")
  speakerId String  @map("speaker_id")
  side      Side
  position  Int // 1..3 substantive (BP: 1..2), 4 = reply
  score     Decimal @db.Decimal(4, 1)
  feedback  String? // the judge's short written comment to this speaker (shown after the round is completed)
  ballot    Ballot  @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([ballotId, side, position])
  @@index([speakerId])
  @@map("speaker_scores")
}

model TeamRegistration {
  id                String             @id @default(cuid())
  tournamentId      String             @map("tournament_id")
  userId            String             @map("user_id")
  teamName          String             @map("team_name")
  institution       String
  speakers          String[]
  contactPhone      String             @map("contact_phone")
  clubId            String?            @map("club_id")
  clubTeamId        String?            @map("club_team_id")
  // school and mixed tournaments: the applicant confirmed that the parents of speakers under 18 agreed
  guardianConsentAt DateTime?          @map("guardian_consent_at")
  lotteryRank       Int?               @map("lottery_rank") // the place in the selection lottery (and in the waitlist after it)
  status            RegistrationStatus @default(pending)
  createdAt         DateTime           @default(now()) @map("created_at")
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamName])
  @@index([userId])
  @@map("team_registrations")
}

// audit log of admin decisions (moderation, payments, visibility, roles, blocks)
model AdminAction {
  id          String   @id @default(cuid())
  adminId     String?  @map("admin_id")
  adminName   String   @map("admin_name") // kept even if the admin account is deleted
  action      String // e.g. tournament.approve, user.block
  targetType  String   @map("target_type") // tournament | user
  targetId    String   @map("target_id")
  targetLabel String   @map("target_label")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_actions")
}

// in-app notification: stored as a type + data so the site renders it in RU/KZ
// (types: participant.*, judge.*, organizer.*, admin.* — see services/notify.ts)
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  data      Json      @default("{}")
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// certificate of a finished tournament; the random code is printed as a QR and checked on /verify/<code>
model Certificate {
  id            String     @id @default(cuid())
  code          String     @unique
  tournamentId  String     @map("tournament_id")
  kind          String // speaker | judge
  speakerId     String?    @map("speaker_id")
  judgeId       String?    @map("judge_id")
  userId        String?    @map("user_id") // the account it belongs to, when there is one
  name          String // as printed (a snapshot)
  teamName      String?    @map("team_name")
  institution   String?
  teamPlace     Int?       @map("team_place") // place in the team standings
  inBreak       Boolean    @default(false) @map("in_break")
  speakerPlace  Int?       @map("speaker_place") // 1..3 in the speaker standings
  breakCategory String?    @map("break_category") // the category bracket the team played in (its name, a snapshot)
  categoryPlace Int?       @map("category_place") // place in that bracket (1 = category champion)
  award         String? // award diplomas (kind = award): best_speaker | best_judge
  issuedAt      DateTime   @default(now()) @map("issued_at")
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, speakerId])
  @@unique([tournamentId, judgeId])
  @@index([userId])
  @@map("certificates")
}

// "looking for a team" / "looking for a speaker" board; the author's contacts are never public
model TeammatePost {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  kind      String // team_needed | speaker_needed
  city      String
  level     TournamentLevel
  languages String[]
  text      String
  closed    Boolean         @default(false)
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   TeammateReply[]

  @@index([closed, expiresAt])
  @@map("teammate_posts")
}

// a reply goes to the author as a notification (one per person and post)
model TeammateReply {
  id        String       @id @default(cuid())
  postId    String       @map("post_id")
  userId    String       @map("user_id")
  message   String
  createdAt DateTime     @default(now()) @map("created_at")
  post      TeammatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("teammate_replies")
}

// behaviour report (bullying, harassment...) for admins and safeguarding officers
model SafetyReport {
  id             String   @id @default(cuid())
  reporterId     String?  @map("reporter_id")
  anonymous      Boolean  @default(false) // hide the reporter's name from the handlers
  category       String // bullying | harassment | inappropriate | threat | other
  about          String? // who or what it is about (free text)
  place          String? // tournament, page or context
  description    String
  status         String   @default("open") // open | in_progress | resolved
  resolutionNote String?  @map("resolution_note")
  handledById    String?  @map("handled_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  reporter       User?    @relation("SafetyReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  handledBy      User?    @relation("SafetyHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("safety_reports")
}

model Testimonial {
  id    String @id @default(cuid())
  name  String
  role  String
  text  String
  order Int    @default(0)

  @@map("testimonials")
}

// ---------- payments ----------

model Payment {
  id           String        @id @default(cuid())
  tournamentId String        @map("tournament_id")
  userId       String?       @map("user_id") // who pays (the organizer)
  amount       Int // tenge, fixed when the reference is issued
  reference    String        @unique // e.g. DKZ-7K2QF9: written in the Kaspi comment so the admin can match the transfer
  status       PaymentStatus @default(awaiting)
  payerNote    String?       @map("payer_note") // payer name / last digits / time, to find the transfer
  receiptPath  String?       @map("receipt_path") // the payer\'s Kaspi receipt, stored privately (not under /uploads)
  adminNote    String?       @map("admin_note") // reason of a rejection
  paidAt       DateTime?     @map("paid_at") // when the organizer pressed "I have paid"
  handledById  String?       @map("handled_by_id")
  handledAt    DateTime?     @map("handled_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User?         @relation("PaymentPayer", fields: [userId], references: [id], onDelete: SetNull)
  handledBy    User?         @relation("PaymentHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tournamentId])
  @@map("payments")
}

// platform-wide settings edited by admins (a single row, id = "main")
model PlatformSetting {
  id             String   @id @default("main")
  proPrice       Int      @default(20000) @map("pro_price") // tenge per tournament above the free team limit
  kaspiRecipient String?  @map("kaspi_recipient") // name shown under the QR, e.g. "Ермек А."
  kaspiPhone     String?  @map("kaspi_phone") // for a transfer by phone number
  kaspiQrUrl     String?  @map("kaspi_qr_url") // uploaded QR image, /uploads/platform/<file>
  paymentNote    String?  @map("payment_note") // extra instructions
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------- clubs ----------
// A club (a university or school debate society) has teams; a person belongs to one club and one of its teams.
// All members are equal: any member edits the club, creates teams, invites by the join link and removes members;
// every change is written to the club log so members see who did what.

model Club {
  id              String            @id @default(cuid())
  name            String
  city            String
  institution     String? // university / school the club belongs to
  description     String            @default("")
  joinCode        String            @unique @map("join_code") // /clubs/join/<code>
  logoUrl         String?           @map("logo_url") // /uploads/logos/…, re-encoded square WebP
  status          ClubStatus        @default(pending)
  moderationNote  String?           @map("moderation_note") // why it was rejected
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  teams           ClubTeam[]
  members         ClubMember[]
  logs            ClubLog[]
  requests        ClubJoinRequest[]
  reports         ClubReport[]
  tournamentTeams Team[]

  @@unique([name, city])
  @@map("clubs")
}

// "this club is fake / a duplicate": a signed-in user tells the admins
model ClubReport {
  id         String    @id @default(cuid())
  clubId     String    @map("club_id")
  userId     String    @map("user_id")
  reason     String
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@map("club_reports")
}

model ClubTeam {
  id              String       @id @default(cuid())
  clubId          String       @map("club_id")
  name            String
  logoUrl         String?      @map("logo_url") // /uploads/logos/…, re-encoded square WebP
  createdAt       DateTime     @default(now()) @map("created_at")
  club            Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  members         ClubMember[]
  tournamentTeams Team[]

  @@unique([clubId, name])
  @@map("club_teams")
}

model ClubMember {
  userId   String    @id @map("user_id") // one club per person
  clubId   String    @map("club_id")
  teamId   String?   @map("team_id") // a team of the same club
  joinedAt DateTime  @default(now()) @map("joined_at")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  club     Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  team     ClubTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@map("club_members")
}

model ClubLog {
  id        String   @id @default(cuid())
  clubId    String   @map("club_id")
  userId    String?  @map("user_id")
  userName  String   @map("user_name") // kept after the account is gone
  action    String // created, edited, joined, left, removed, team.created, team.renamed, team.deleted, team.assigned, code.reset
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@map("club_logs")
}

// ---------- news of the debate world (written by admins) ----------

model News {
  id          String    @id @default(cuid())
  title       String
  summary     String // one or two sentences for the list
  body        String // paragraphs separated by blank lines; links are plain URLs
  coverUrl    String?   @map("cover_url")
  published   Boolean   @default(false) // drafts are seen only by admins
  publishedAt DateTime? @map("published_at")
  authorId    String?   @map("author_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@map("news")
}

// a request to join a club from its public page; any member accepts (choosing the team) or declines it
// a new club waits for an admin: only an approved club appears in the catalogue and can apply to tournaments
enum ClubStatus {
  pending
  approved
  rejected
}

enum ClubRequestStatus {
  pending
  accepted
  declined
  cancelled
}

model ClubJoinRequest {
  id          String            @id @default(cuid())
  clubId      String            @map("club_id")
  userId      String            @map("user_id")
  message     String            @default("")
  status      ClubRequestStatus @default(pending)
  handledById String?           @map("handled_by_id")
  handledAt   DateTime?         @map("handled_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User              @relation("ClubRequester", fields: [userId], references: [id], onDelete: Cascade)
  handledBy   User?             @relation("ClubRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, status])
  @@map("club_join_requests")
}
