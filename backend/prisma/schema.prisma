// Debate.kz database schema (PostgreSQL 16, Prisma 7)
// Connection URL lives in prisma.config.ts (Prisma 7 style), not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

// Global roles only. Organizer / judge / speaker are rights inside a tournament.
enum Role {
  user
  admin
}

enum OrganizerRole {
  owner
  co_organizer
}

enum InviteKind {
  judge
  co_organizer
}

enum TokenPurpose {
  verify_email
  reset_password
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum TournamentLevel {
  school
  university
}

enum TournamentStatus {
  registration
  ongoing
  finished
}

enum RoundStatus {
  draft
  released
  completed
}

enum Side {
  proposition
  opposition
}

enum BallotStatus {
  pending
  submitted
  confirmed
}

enum RegistrationStatus {
  pending
  confirmed
  rejected
}

// judge levels are earned automatically (see services/judgeLevels.ts); an admin may set a minimum
enum JudgeLevel {
  novice
  judge
  experienced
  chief
}

enum Plan {
  free
  pro
}

// ---------- people ----------

model User {
  id                String      @id @default(cuid())
  email             String      @unique
  passwordHash      String      @map("password_hash")
  name              String
  phone             String?
  role              Role        @default(user)
  institution       String?
  city              String?
  avatarUrl         String?     @map("avatar_url") // /uploads/avatars/<file>.webp
  blocked           Boolean     @default(false)
  emailVerifiedAt   DateTime?   @map("email_verified_at")
  consentAt         DateTime?   @map("consent_at") // consent to personal data processing
  passwordChangedAt DateTime?   @map("password_changed_at") // sessions issued before this are rejected
  judgeLevelMin     JudgeLevel? @map("judge_level_min") // admin-set floor for known judges (cold start)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  organizedTournaments TournamentOrganizer[]
  judgeProfiles        Judge[]
  speakerProfiles      Speaker[]
  registrations        TeamRegistration[]
  emailTokens          EmailToken[]
  createdInvites       TournamentInvite[]    @relation("InviteCreatedBy")
  usedInvites          TournamentInvite[]    @relation("InviteUsedBy")
  adminActions         AdminAction[]
  judgeFeedback        JudgeFeedback[]
  judgeReviews         JudgeReview[]

  @@map("users")
}

// one-time email links (verification, password reset); only the SHA-256 hash is stored
model EmailToken {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  purpose   TokenPurpose @default(verify_email)
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_tokens")
}

model Institution {
  id    String          @id @default(cuid())
  name  String          @unique
  city  String?
  level TournamentLevel

  teams  Team[]
  judges Judge[]

  @@map("institutions")
}

// ---------- tournaments ----------

model Tournament {
  id                   String           @id @default(cuid())
  name                 String
  city                 String
  startDate            DateTime         @map("start_date") @db.Date
  endDate              DateTime         @map("end_date") @db.Date
  format               String           @default("WSDC")
  level                TournamentLevel
  status               TournamentStatus @default(registration)
  maxTeams             Int              @map("max_teams")
  coverUrl             String?          @map("cover_url")
  organizerName        String           @map("organizer_name")
  description          String           @default("")
  preliminaryRounds    Int              @map("preliminary_rounds")
  breakSize            Int              @map("break_size")
  languages            String[]
  plan                 Plan             @default(free)
  paid                 Boolean          @default(true)
  visible              Boolean          @default(true)
  registrationOpen     Boolean          @default(true) @map("registration_open")
  requireApproval      Boolean          @default(true) @map("require_approval")
  registrationDeadline DateTime?        @map("registration_deadline") @db.Date
  moderation           ModerationStatus @default(pending) // public only after admin approval
  moderationNote       String?          @map("moderation_note")
  rooms                String[]         @default([]) // organizer's own room names for the draw; empty = default list
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organizers    TournamentOrganizer[]
  scoringConfig ScoringConfig?
  teams         Team[]
  judges        Judge[]
  rounds        Round[]
  schedule      ScheduleItem[]
  registrations TeamRegistration[]
  invites       TournamentInvite[]

  @@index([status, startDate])
  @@index([moderation])
  @@map("tournaments")
}

model TournamentOrganizer {
  tournamentId String        @map("tournament_id")
  userId       String        @map("user_id")
  role         OrganizerRole @default(owner)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@map("tournament_organizers")
}

// Invitation link to join a tournament as judge or co-organizer; only the token hash is stored
model TournamentInvite {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  kind         InviteKind
  tokenHash    String     @unique @map("token_hash")
  createdById  String     @map("created_by_id")
  usedById     String?    @map("used_by_id")
  expiresAt    DateTime   @map("expires_at")
  usedAt       DateTime?  @map("used_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy       User?      @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("tournament_invites")
}

// WSDC score ranges; kept per tournament so other formats can plug in later
model ScoringConfig {
  tournamentId String     @id @map("tournament_id")
  speakerMin   Decimal    @default(60) @map("speaker_min") @db.Decimal(4, 1)
  speakerMax   Decimal    @default(80) @map("speaker_max") @db.Decimal(4, 1)
  replyMin     Decimal    @default(30) @map("reply_min") @db.Decimal(4, 1)
  replyMax     Decimal    @default(40) @map("reply_max") @db.Decimal(4, 1)
  step         Decimal    @default(0.5) @db.Decimal(3, 1)
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("scoring_configs")
}

model ScheduleItem {
  id           String     @id @default(cuid())
  tournamentId String     @map("tournament_id")
  day          Int
  time         String
  title        String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("schedule_items")
}

model Team {
  id            String          @id @default(cuid())
  tournamentId  String          @map("tournament_id")
  name          String
  institutionId String?         @map("institution_id")
  city          String?
  createdAt     DateTime        @default(now()) @map("created_at")
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution   Institution?    @relation(fields: [institutionId], references: [id])
  speakers      Speaker[]
  propositionIn Debate[]        @relation("PropositionTeam")
  oppositionIn  Debate[]        @relation("OppositionTeam")
  judgeFeedback JudgeFeedback[]

  @@unique([tournamentId, name])
  @@map("teams")
}

model Speaker {
  id       String         @id @default(cuid())
  teamId   String         @map("team_id")
  name     String
  position Int // 1..3 inside the team
  userId   String?        @map("user_id")
  team     Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  scores   SpeakerScore[]

  @@index([teamId])
  @@map("speakers")
}

model Judge {
  id            String          @id @default(cuid())
  tournamentId  String          @map("tournament_id")
  name          String
  institutionId String?         @map("institution_id")
  rating        Int             @default(5) // 1..10
  userId        String?         @map("user_id")
  tournament    Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  institution   Institution?    @relation(fields: [institutionId], references: [id])
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  debates       DebateJudge[]
  ballots       Ballot[]
  feedback      JudgeFeedback[]
  review        JudgeReview?

  @@index([tournamentId])
  @@index([userId])
  @@map("judges")
}

model Round {
  id           String      @id @default(cuid())
  tournamentId String      @map("tournament_id")
  number       Int
  name         String
  motion       String      @default("")
  infoSlide    String?     @map("info_slide")
  status       RoundStatus @default(draft)
  date         DateTime    @db.Date
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  debates      Debate[]

  @@unique([tournamentId, number])
  @@map("rounds")
}

model Debate {
  id                String          @id @default(cuid())
  roundId           String          @map("round_id")
  room              String
  propositionTeamId String          @map("proposition_team_id")
  oppositionTeamId  String          @map("opposition_team_id")
  winner            Side?
  ballotStatus      BallotStatus    @default(pending) @map("ballot_status")
  round             Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  proposition       Team            @relation("PropositionTeam", fields: [propositionTeamId], references: [id], onDelete: Cascade)
  opposition        Team            @relation("OppositionTeam", fields: [oppositionTeamId], references: [id], onDelete: Cascade)
  judges            DebateJudge[]
  ballots           Ballot[]
  feedback          JudgeFeedback[]

  @@index([roundId])
  @@map("debates")
}

model DebateJudge {
  debateId String  @map("debate_id")
  judgeId  String  @map("judge_id")
  isChair  Boolean @default(false) @map("is_chair")
  debate   Debate  @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge    Judge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@id([debateId, judgeId])
  @@index([judgeId])
  @@map("debate_judges")
}

// one ballot per judge per debate
model Ballot {
  id          String         @id @default(cuid())
  debateId    String         @map("debate_id")
  judgeId     String         @map("judge_id")
  winner      Side
  submittedAt DateTime       @default(now()) @map("submitted_at")
  debate      Debate         @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge       Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  scores      SpeakerScore[]

  @@unique([debateId, judgeId])
  @@map("ballots")
}

model SpeakerScore {
  id        String  @id @default(cuid())
  ballotId  String  @map("ballot_id")
  speakerId String  @map("speaker_id")
  side      Side
  position  Int // 1..3 substantive, 4 = reply
  score     Decimal @db.Decimal(4, 1)
  ballot    Ballot  @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  speaker   Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([ballotId, side, position])
  @@index([speakerId])
  @@map("speaker_scores")
}

// a team's feedback on a judge of its debate (one per team, judge and debate).
// Individual rows are seen only by the tournament's organizers and admins; the judge sees aggregates.
model JudgeFeedback {
  id         String   @id @default(cuid())
  debateId   String   @map("debate_id")
  judgeId    String   @map("judge_id")
  teamId     String   @map("team_id")
  fromUserId String?  @map("from_user_id")
  score      Int // 1..5
  comment    String?
  teamWon    Boolean  @map("team_won") // winners and losers are averaged separately (revenge protection)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  debate     Debate   @relation(fields: [debateId], references: [id], onDelete: Cascade)
  judge      Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fromUser   User?    @relation(fields: [fromUserId], references: [id], onDelete: SetNull)

  @@unique([debateId, judgeId, teamId])
  @@index([judgeId])
  @@map("judge_feedback")
}

// the organizer's overall rating of a judge for one tournament
model JudgeReview {
  judgeId   String   @id @map("judge_id")
  score     Int // 1..5
  byUserId  String?  @map("by_user_id")
  updatedAt DateTime @updatedAt @map("updated_at")
  judge     Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  byUser    User?    @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@map("judge_reviews")
}

model TeamRegistration {
  id           String             @id @default(cuid())
  tournamentId String             @map("tournament_id")
  userId       String             @map("user_id")
  teamName     String             @map("team_name")
  institution  String
  speakers     String[]
  contactPhone String             @map("contact_phone")
  status       RegistrationStatus @default(pending)
  createdAt    DateTime           @default(now()) @map("created_at")
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, teamName])
  @@index([userId])
  @@map("team_registrations")
}

// audit log of admin decisions (moderation, payments, visibility, roles, blocks)
model AdminAction {
  id          String   @id @default(cuid())
  adminId     String?  @map("admin_id")
  adminName   String   @map("admin_name") // kept even if the admin account is deleted
  action      String // e.g. tournament.approve, user.block
  targetType  String   @map("target_type") // tournament | user
  targetId    String   @map("target_id")
  targetLabel String   @map("target_label")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_actions")
}

model Testimonial {
  id    String @id @default(cuid())
  name  String
  role  String
  text  String
  order Int    @default(0)

  @@map("testimonials")
}
