# Copy to .env and fill in real values
DATABASE_URL="postgresql://debate_app:CHANGE_ME@localhost:5432/debatekz_dev?schema=public"
# long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Optional Telegram bot (create it in @BotFather). Leave empty to keep the bot off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional "Sign in with Google" — see README "Вход через Google". Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional real email (SMTP). Empty = letters are printed to the console.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address, SMTP_PASS=a 16-letter app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
