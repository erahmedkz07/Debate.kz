# Production settings for the API. Copy to /etc/debatekz/api.env (root:debatekz, 640).
# The API refuses to start in production if something below is missing or unsafe.
NODE_ENV=production
PORT=4000

# filled in by deploy/create-db.sh
DATABASE_URL=

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# the site address, https only (session cookies are HTTPS-only)
CLIENT_ORIGIN=https://debate.kz

# uploads and payment receipts: outside the code, included in backups
STORAGE_DIR=/var/lib/debatekz

# email on the site's own domain (SPF/DKIM/DMARC set up, see deploy/README.md)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Debate.kz <no-reply@debate.kz>"

# a SEPARATE bot for production (@BotFather): dev and prod must never poll the same token
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Google sign-in: add https://debate.kz/api/auth/google/callback to the OAuth client's redirect URIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# monitoring (deploy/healthcheck.sh): a Telegram chat that gets "the site is down" alerts
ALERT_CHAT_ID=
